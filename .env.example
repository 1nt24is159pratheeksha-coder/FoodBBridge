# Lovable Cloud (auto-provided)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY= 
SUPABASE_SERVICE_ROLE_KEY=
# GroqCloud API (server-only; used for conversation and image assessment)
GROQ_API_KEY=
# Lovable connector (server-only; used to retrieve Twilio-hosted media)
LOVABLE_API_KEY=
# Twilio connector (linked via Connectors -> Twilio)
TWILIO_API_KEY=
# Optional: enables X-Twilio-Signature verification
TWILIO_AUTH_TOKEN=
# Shared secret appended to the webhook URL: /api/public/twilio/whatsapp?token=...
WHATSAPP_WEBHOOK_TOKEN=
